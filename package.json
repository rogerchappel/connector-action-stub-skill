{
  "name": "connector-action-stub-skill",
  "version": "0.1.0",
  "description": "Generate dry-run stubs and approval checklists for connector actions.",
  "type": "module",
  "bin": {
    "connector-action-stub": "./src/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check src/index.js && node --check src/cli.js && node --check scripts/*.js && node --check tests/*.test.js",
    "build": "rm -rf dist && mkdir -p dist && cp -R src dist/src",
    "build:smoke": "node scripts/build-smoke.js",
    "smoke": "node scripts/smoke.js",
    "package:smoke": "npm run build:smoke && node scripts/package-smoke.js",
    "release:contract": "node scripts/check-release-contract.js",
    "release:check": "npm run release:contract && npm run check && npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "agent",
    "skill",
    "dry-run",
    "connector",
    "cli"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "dist/src",
    "scripts",
    "docs",
    "examples",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/connector-action-stub-skill.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/connector-action-stub-skill/issues"
  },
  "homepage": "https://github.com/rogerchappel/connector-action-stub-skill#readme"
}
